<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuración de cobertura (coverlet).
  Se excluyen las migraciones porque son código generado por "dotnet ef" y no
  lógica escrita a mano; incluirlas solo distorsionaría el porcentaje.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[MarcasAutos.Api]*</Include>
          <ExcludeByFile>**/Data/Migrations/*.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
